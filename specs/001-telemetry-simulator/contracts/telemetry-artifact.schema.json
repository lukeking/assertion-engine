{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lukeking/assertion-engine/main/specs/001-telemetry-simulator/contracts/telemetry-artifact.schema.json",
  "title": "Assertion Engine M0 telemetry artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_version",
    "scenario",
    "snapshots"
  ],
  "properties": {
    "artifact_version": {
      "const": "1.0.0"
    },
    "scenario": {
      "$ref": "common.schema.json#/$defs/scenarioSource"
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/telemetrySnapshot"
      }
    }
  },
  "$defs": {
    "telemetrySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle_id",
        "sequence_number",
        "mission_time_s",
        "position_ned_m",
        "velocity_ned_mps",
        "battery_percent"
      ],
      "properties": {
        "vehicle_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 0
        },
        "mission_time_s": {
          "type": "number",
          "minimum": 0
        },
        "position_ned_m": {
          "$ref": "common.schema.json#/$defs/nedVector"
        },
        "velocity_ned_mps": {
          "$ref": "common.schema.json#/$defs/nedVector"
        },
        "battery_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
